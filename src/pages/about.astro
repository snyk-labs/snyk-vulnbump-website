---
import PageHero from "../components/site/PageHero.astro";
import { benchmark, site } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorLine, indexLabel } from "../lib/words";

const principles = [
  ["Fixed targets", "Every configuration attempts the same vulnerabilities in the same repository state."],
  ["Verified outcomes", "A verifier that never trusts the agent's report checks the fix in a fresh container."],
  ["A joint verdict", "An upgrade passes only if the vulnerability is fixed and the build and tests still pass."],
  ["Honest uncertainty", "Per-repository rates and repository-clustered significance tests sit beside the pooled rates; repeated runs are next."],
  ["Reproducible data", "Versioned results and definitions remain downloadable."],
];
---

<BaseLayout title="About" description={`About the ${site.name} benchmark initiative.`}>
  <PageHero
    eyebrow="About"
    title="Evidence before"
    keyword="rankings."
    description="A Snyk benchmark initiative publishing transparent, versioned evidence about automated vulnerability remediation."
  />

  <section class="section">
    <div class="container grid">
      <div class="prose">
        <p>
          {site.name} measures whether an AI agent can upgrade a vulnerable
          dependency and leave the project working: dependencies resolve, the
          vulnerability is gone on a Snyk rescan, the build passes, and the tests
          still pass.
        </p>
        <p>
          The first release compares Snyk's Evo Remediation Agent with Claude
          Code, with and without a Snyk scan, on the same 307 upgrades across 43
          real repositories, all on the same model, alongside a non-agentic
          baseline that only applies Snyk's recommended version. Each release
          defines its repositories, agents, and gates up front and publishes the
          data behind every chart.
        </p>
        <p>
          It is a companion to
          {" "}<a href="https://vulnbench.com/">Snyk VulnBench</a>, which studies
          how reliably AI systems find vulnerabilities.
        </p>
        <p>
          The benchmark is described in {benchmark.paper.title}, by
          {" "}{authorLine(benchmark.paper.authors)}.
        </p>
      </div>

      <div>
        <p class="eyebrow">Principles</p>
        <ol class="principles">
          {
            principles.map(([term, description], i) => (
              <li>
                <span class="metric">{indexLabel(i)}</span>
                <div>
                  <h2>{term}</h2>
                  <p>{description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-7);
  }

  .principles {
    padding: 0;
    margin: var(--space-4) 0 0;
    list-style: none;
  }

  .principles li {
    display: grid;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    gap: var(--space-4);
    grid-template-columns: 2.5rem minmax(0, 1fr);
  }

  .principles .metric {
    color: var(--ink-faint);
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }

  h2 {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .principles p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
