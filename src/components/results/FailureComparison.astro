---
import { benchmark, firstFailedGates } from "../../data";
import { displayOrder } from "../../lib/colors";
import { formatInteger } from "../../lib/format";

/*
 * Where the harnesses fail (paper section 5.3). First: one stack per harness
 * of its failures by the first verification gate they hit (Figure 4), so each
 * failure counts once. Then: one root cause per failure, grouped by cause
 * (Table 4).
 */
const { configurations, rootCauses, baseline, release } = benchmark;
const column = (
  c: { id: string; label: string; flow: number[]; attempts: number; passed: number },
  highlight: boolean,
  isBaseline: boolean,
) => ({ id: c.id, label: c.label, flow: c.flow, attempts: c.attempts, passed: c.passed, highlight, isBaseline });
/** Table 4 keeps the paper's column order: the non-agentic baseline first, then the agents. */
const columns = [
  column(baseline, false, true),
  ...configurations.map((c) => column(c, c.highlight, false)),
];
/** The stacks read in display order: the highlighted agent first, the baseline last. */
const stacks = [
  ...displayOrder(configurations).map((c) => column(c, c.highlight, false)),
  column(baseline, false, true),
].map((c) => ({ ...c, segments: firstFailedGates(c), failures: c.attempts - c.passed }));
const stageNames = ["dependencies", "rescan", "build", "tests"];
---

<figure class="chart">
  <div class="failstacks">
    {
      stacks.map((s) => (
        <div class:list={["failstack-row", { "failstack-row--baseline": s.isBaseline }]}>
          <div>
            <p class="failstack-row__name">{s.label}</p>
            <p class="failstack-row__total metric">
              {formatInteger(s.failures)} failures{s.isBaseline ? " · non-agentic baseline" : ""}
            </p>
          </div>
          <div
            class="failstack"
            role="img"
            aria-label={`${s.label}: ${s.segments.map((g, i) => `${g.count} failed first at ${stageNames[i]}`).join(", ")}`}
          >
            {s.segments.map((g) => (
              <span style={g.count > 0 ? `flex: ${g.count} 0 0` : "flex: 0 0 0; padding: 0"}>
                {g.count > 0 ? formatInteger(g.count) : ""}
              </span>
            ))}
          </div>
        </div>
      ))
    }
    <div class="failstack-row failstack-row--key">
      <div />
      <ul class="failstack-key" aria-label="Legend">
        {stageNames.map((name, i) => (
          <li>
            <span class={`failstack-key__swatch failstack-key__swatch--${i + 1}`} aria-hidden="true" />
            Failed at {name}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="table-scroll">
    <table class="data-table causes">
      <caption>
        Root cause of every failed attempt
        <small>{rootCauses.note}</small>
      </caption>
      <thead>
        <tr>
          <th scope="col">Cause</th>
          {
            columns.map((c) => (
              <th scope="col" class:list={["num", { "is-highlight": c.highlight }]}>{c.label}</th>
            ))
          }
        </tr>
      </thead>
      {
        rootCauses.groups.map((group) => (
          <tbody>
            <tr class="group">
              <th scope="row">
                {group.label}
                <small>{group.description}</small>
              </th>
              {columns.map((c) => <td class="num">{group.counts[c.id] ?? 0}</td>)}
            </tr>
            {group.causes.map((cause) => (
              <tr class="cause">
                <th scope="row">{cause.label}</th>
                {columns.map((c) => <td class="num">{cause.counts[c.id] ?? 0}</td>)}
              </tr>
            ))}
          </tbody>
        ))
      }
      <tfoot>
        <tr>
          <th scope="row">Failed attempts</th>
          {columns.map((c) => <td class="num">{formatInteger(c.attempts - c.passed)}</td>)}
        </tr>
      </tfoot>
    </table>
  </div>

  <figcaption class="chart__caption">
    <span>Dataset {release.datasetVersion}</span>
    <span>The verifier runs every gate; each failure is counted once, at the first gate it failed</span>
    <span>Root causes are grouped by cause, not by gate: runtime version constraints surface at the rescan, compiler ones at the build</span>
  </figcaption>
</figure>

<style>
  .failstacks {
    display: grid;
    gap: 1.375rem;
  }

  .failstack-row {
    display: grid;
    gap: 0.5rem 1.5rem;
    align-items: center;
  }

  .failstack-row__name {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .failstack-row--baseline .failstack-row__name {
    color: var(--ink-soft);
  }

  .failstack-row__total {
    margin-top: 0.25rem;
    color: var(--ink-faint);
    font-size: 0.8125rem;
  }

  .failstack-row--baseline .failstack {
    opacity: 0.85;
  }

  .failstack-key {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
    gap: 0.5rem 1.375rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    list-style: none;
  }

  .failstack-key li {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .failstack-key__swatch {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
  }

  .failstack-key__swatch--1 {
    background: var(--fail-1);
  }

  .failstack-key__swatch--2 {
    background: var(--fail-2);
  }

  .failstack-key__swatch--3 {
    background: var(--fail-3);
  }

  .failstack-key__swatch--4 {
    background: var(--fail-4);
  }

  .causes {
    margin-top: var(--space-5);
  }

  .causes caption {
    padding-bottom: var(--space-3);
    color: #ffffff;
    font-weight: 600;
    text-align: left;
  }

  .causes caption small,
  .causes th small {
    display: block;
    margin-top: 0.2rem;
    color: var(--ink-faint);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .causes thead th.is-highlight {
    color: #ffffff;
  }

  .causes .group th,
  .causes .group td {
    border-top: 1px solid var(--rule-strong);
    color: #ffffff;
    font-weight: 600;
  }

  .causes .cause th {
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-weight: 400;
  }

  .causes tfoot th,
  .causes tfoot td {
    border-top: 1px solid var(--rule-strong);
    color: #ffffff;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .failstack-row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
</style>
