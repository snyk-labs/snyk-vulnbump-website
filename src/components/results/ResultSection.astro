---
interface Props {
  id: string;
  /** Zero-padded section number, e.g. "02"; shown before the eyebrow. */
  index?: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, index, eyebrow, title, description } = Astro.props;
---

<section class="result-section container" id={id} aria-labelledby={`${id}-title`}>
  <div class="head">
    <p class="eyebrow">
      {index && <span class="index metric accent-pass">{index}</span>}
      {eyebrow}
    </p>
    <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    {description && <p class="description">{description}</p>}
  </div>
  <slot />
</section>

<style>
  .result-section {
    padding-top: 5rem;
    scroll-margin-top: var(--space-4);
  }

  .head {
    display: grid;
    max-width: 52rem;
    gap: 0.625rem;
    margin-bottom: 1.75rem;
  }

  .index {
    margin-right: 0.75rem;
  }

  .description {
    margin-top: 0.375rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
