---
import { benchmark } from "../../data";
import type { Configuration } from "../../data/schema";
import { formatInteger } from "../../lib/format";

/*
 * Quality and integrity signals the harness records alongside the gates,
 * side by side for every configuration. Severity splits are
 * critical/high/medium/low.
 */
const { qualitySignals, configurations } = benchmark;

type QualityKey = keyof Configuration["quality"];

function cell(c: Configuration, key: string) {
  const value = c.quality[key as QualityKey];
  if (Array.isArray(value)) {
    return {
      total: value.reduce((a, b) => a + b, 0),
      split: value.join(" / "),
    };
  }
  return { total: value, split: null };
}
---

<div class="table-scroll">
  <table class="data-table integrity">
    <caption class="visually-hidden">Quality and integrity signals by configuration</caption>
    <thead>
      <tr>
        <th scope="col">Signal</th>
        {
          configurations.map((c) => (
            <th scope="col" class:list={["num", { "is-highlight": c.highlight }]}>
              {c.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        qualitySignals.map((signal) => (
          <tr class:list={{ attention: signal.attention }}>
            <th scope="row">
              {signal.label}
              <small>{signal.description}</small>
            </th>
            {configurations.map((c) => {
              const { total, split } = cell(c, signal.key);
              return (
                <td class="num">
                  {formatInteger(total)}
                  {split && <small>{split}</small>}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .integrity th small,
  .integrity td small {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink-faint);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .integrity tbody th {
    max-width: 26rem;
  }

  .integrity thead .is-highlight {
    color: #ffffff;
  }

  .integrity tr.attention th {
    box-shadow: inset 2px 0 0 var(--amber);
  }

  .integrity td {
    font-size: var(--step-0);
  }
</style>
