---
import { benchmark } from "../../data";
import { indexLabel } from "../../lib/words";

/* Findings, each with the caveat that qualifies it (2b design). */
const { findings } = benchmark;
---

<ol class="findings">
  {
    findings.map(({ title, summary, caveat, href }, i) => (
      <li class="finding">
        <span class="finding__n metric accent-pass">{indexLabel(i)}</span>
        <div>
          <h2 class="finding__title">{title}</h2>
          <p class="finding__summary">{summary}</p>
          <a class="finding__more" href={href}>See the evidence →</a>
        </div>
        <div class="caveat">
          <p class="caveat__label">Caveat</p>
          <p class="caveat__text">{caveat}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .findings {
    padding: 0;
    margin: 3.5rem 0 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .finding {
    display: grid;
    gap: 1rem 2.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .finding__n {
    padding-top: 0.375rem;
    font-size: 0.875rem;
  }

  .finding__title {
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.625rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .finding__summary {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .finding__more {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--pass-text);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .caveat {
    align-self: start;
    margin-top: 0.375rem;
  }

  .caveat__text {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (min-width: 60rem) {
    .finding {
      grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
