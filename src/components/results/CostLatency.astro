---
import { benchmark } from "../../data";
import type { Configuration } from "../../data/schema";
import { configColors } from "../../lib/colors";
import { formatSeconds, formatUsd } from "../../lib/format";

/*
 * Per-attempt cost and latency as percentile strips on a shared axis per
 * metric: a range from the median (dot) to p95, with mean and p90 ticks.
 * Every marker is labelled with its value.
 */
const { configurations, release, pricing } = benchmark;
const colors = configColors(configurations);

type Pick = (c: Configuration) => { mean: number; p50: number; p90: number; p95: number };

const panels: {
  id: string;
  title: string;
  pick: Pick;
  format: (v: number) => string;
}[] = [
  { id: "latency", title: "Latency per attempt", pick: (c) => c.latencySeconds, format: formatSeconds },
  { id: "cost", title: "Cost per attempt", pick: (c) => c.cost.perAttempt, format: formatUsd },
];

const methodLabel = {
  "list-price-estimate": `estimated at $${pricing.inputPerMillion}/M input, $${pricing.outputPerMillion}/M output tokens`,
  "tool-reported": "tool-reported, includes prompt caching",
} as const;
---

<figure class="chart">
  <div class="panels">
    {
      panels.map(({ id, title, pick, format }) => {
        const max = Math.max(...configurations.map((c) => pick(c).p95));
        const pos = (v: number) => `${(v / max) * 100}%`;
        return (
          <section class="chart__plot panel" aria-labelledby={`panel-${id}`}>
            <h3 id={`panel-${id}`}>{title}</h3>
            <ul>
              {configurations.map((c) => {
                const p = pick(c);
                return (
                  <li aria-label={`${c.label}: median ${format(p.p50)}, mean ${format(p.mean)}, p90 ${format(p.p90)}, p95 ${format(p.p95)}`}>
                    <span class:list={["name", { "is-highlight": c.highlight }]}>{c.label}</span>
                    <span class="strip" aria-hidden="true">
                      <span class="range" style={`left: ${pos(p.p50)}; width: calc(${pos(p.p95)} - ${pos(p.p50)}); background: ${colors[c.id]}`} />
                      <span class="tick" style={`left: ${pos(p.p90)}`} />
                      <span class="tick tick--mean" style={`left: ${pos(p.mean)}`} />
                      <span class="dot" style={`left: ${pos(p.p50)}; background: ${colors[c.id]}`} />
                    </span>
                    <span class="values metric">
                      <span><b>{format(p.p50)}</b> median</span>
                      <span>{format(p.mean)} mean</span>
                      <span>{format(p.p90)} p90</span>
                      <span>{format(p.p95)} p95</span>
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })
    }
  </div>

  <details class="chart__table" open>
    <summary>Totals and cost method</summary>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Configuration</th>
            <th scope="col" class="num">Mean latency</th>
            <th scope="col" class="num">Mean cost</th>
            <th scope="col" class="num">Total cost</th>
            <th scope="col">Cost method</th>
          </tr>
        </thead>
        <tbody>
          {
            configurations.map((c) => (
              <tr>
                <th scope="row">{c.label}</th>
                <td class="num">{formatSeconds(c.latencySeconds.mean)}</td>
                <td class="num">{formatUsd(c.cost.perAttempt.mean)}</td>
                <td class="num">{formatUsd(c.cost.total)}</td>
                <td>{methodLabel[c.cost.method]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <figcaption class="chart__caption">
    <span>Dataset {release.datasetVersion}</span>
    <span>Dot = median · bar = median to p95 · ticks = mean (dashed) and p90</span>
    <span>Latency = the agent's run alone, excluding the harness's install, scan, build, and tests</span>
    <span>Costs use different methods and are not directly comparable; token counts are not comparable either</span>
  </figcaption>
</figure>

<style>
  .panels {
    display: grid;
    gap: var(--space-4);
  }

  .panel {
    display: grid;
    gap: var(--space-4);
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .panel ul {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-4);
    list-style: none;
  }

  .panel li {
    display: grid;
    gap: 0.45rem;
  }

  .name {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .name.is-highlight {
    color: #ffffff;
    font-weight: 600;
  }

  .strip {
    position: relative;
    height: 1rem;
    border-bottom: 1px solid var(--chart-axis);
  }

  .range {
    position: absolute;
    top: 0.3rem;
    height: 0.4rem;
    border-radius: 0 4px 4px 0;
    opacity: 0.55;
  }

  .tick {
    position: absolute;
    top: 0.05rem;
    width: 0;
    height: 0.9rem;
    border-left: 2px solid #ffffff;
  }

  .tick--mean {
    border-left-style: dashed;
  }

  .dot {
    position: absolute;
    top: 0.1rem;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--chart-surface);
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    color: var(--ink-faint);
    font-size: 0.7rem;
  }

  .values b {
    color: #ffffff;
    font-weight: 500;
  }

  @media (min-width: 60rem) {
    .panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
