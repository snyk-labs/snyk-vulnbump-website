---
import { benchmark } from "../../data";
import { indexLabel } from "../../lib/words";

const { methodology } = benchmark;
---

<section class="section" aria-labelledby="method-title">
  <div class="container">
    <div class="top">
      <div class="section-heading">
        <p class="eyebrow">Method</p>
        <h2 id="method-title">How a bump gets judged.</h2>
      </div>
      <a class="text-link" href="/methodology">Full methodology</a>
    </div>

    <ol class="pipeline" style={`--steps: ${Math.min(methodology.length, 6)}`}>
      {
        methodology.map(({ title, when, text, steps }, i) => (
          <li>
            <span class="node metric" aria-hidden="true">{indexLabel(i)}</span>
            <p class="when metric">{when}</p>
            <h3>{title}</h3>
            <p>{text}</p>
            <ul class="steps">
              {steps.map((step) => <li>{step}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
    <p class="verdict">
      <span class="metric">PASS</span> only if all four gates pass.
    </p>
  </div>
</section>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: end;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .section-heading {
    margin-bottom: 0;
  }

  /* Vertical track on small screens, horizontal track on wide ones. */
  .pipeline {
    position: relative;
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-5);
    list-style: none;
  }

  .pipeline > li {
    position: relative;
    display: grid;
    padding-left: 3.25rem;
    gap: var(--space-2);
  }

  .pipeline > li::before {
    position: absolute;
    top: 2.4rem;
    bottom: calc(var(--space-5) * -1);
    left: 1.1rem;
    border-left: 1px solid var(--rule-strong);
    content: "";
  }

  .pipeline > li:last-child::before {
    display: none;
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--pink);
    border-radius: 50%;
    background: var(--midnight);
    color: #ffffff;
    font-size: 0.7rem;
    place-items: center;
  }

  h3 {
    padding-top: 0.35rem;
    font-size: var(--step-0);
    font-weight: 600;
  }

  .pipeline p {
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .pipeline .when {
    color: var(--ink-soft);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Sub-steps inside a phase: a plain list, without the phase track. */
  .steps {
    display: grid;
    padding: 0;
    margin: var(--space-2) 0 0;
    gap: 0.35rem;
    list-style: none;
  }

  .pipeline .steps li {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .pipeline .steps li::before {
    display: none;
  }

  .verdict {
    margin-top: var(--space-5);
    color: var(--ink-soft);
  }

  .verdict .metric {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--pink);
    border-radius: var(--radius-pill);
    color: #ffffff;
    font-size: 0.75rem;
  }

  @media (min-width: 60rem) {
    .pipeline {
      gap: var(--space-4);
      grid-template-columns: repeat(var(--steps, 6), minmax(0, 1fr));
    }

    .pipeline > li {
      padding-top: 3.4rem;
      padding-left: 0;
      align-content: start;
    }

    .pipeline > li::before {
      top: 1.1rem;
      right: calc(var(--space-4) * -1);
      bottom: auto;
      left: 2.2rem;
      border-top: 1px solid var(--rule-strong);
      border-left: 0;
    }

    h3 {
      padding-top: 0;
    }
  }
</style>
