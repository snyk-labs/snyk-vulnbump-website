---
import { benchmark } from "../../data";
import { countWord, indexLabel } from "../../lib/words";
import GradientText from "../brand/GradientText.astro";

const { findings } = benchmark;
---

<section class="section" aria-labelledby="findings-title">
  <div class="container grid">
    <div class="section-heading">
      <p class="eyebrow">What we found</p>
      <h2 id="findings-title">
        {countWord(findings.length)} things the data says.
      </h2>
      <p class="lede">
        Read each one with its caveat. The results describe these projects and
        targets, not every codebase.
      </p>
    </div>

    <ol class="index">
      {
        findings.map(({ title, summary, caveat, href }, i) => (
          <li>
            <span class="numeral">
              <GradientText text={indexLabel(i)} id={`finding-${i}`} layout="inline" />
            </span>
            <div class="body">
              <h3>{title}</h3>
              <p>{summary}</p>
              <p class="caveat">
                <span class="caveat__label">Caveat</span> {caveat}
              </p>
              <a class="text-link" href={href}>See the evidence</a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-6);
  }

  .section-heading {
    align-content: start;
    margin-bottom: 0;
  }

  .index {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .index li {
    display: grid;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-2) var(--space-5);
    grid-template-columns: 4.5rem minmax(0, 1fr);
  }

  .index li:first-child {
    padding-top: 0;
  }

  .numeral {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 600;
  }

  .body > p {
    max-width: 38rem;
  }

  .caveat {
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .caveat__label {
    margin-right: 0.35rem;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .text-link {
    margin-top: var(--space-1);
  }

  @media (max-width: 35rem) {
    .index li {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }

    .section-heading {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
