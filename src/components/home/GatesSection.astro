---
import { benchmark, funnelLanes, gateDetails } from "../../data";
import { GateFunnel } from "../charts/GateFunnel";

/* The hero chart: every upgrade narrowing through the four gates, per harness. */
const { flowSteps, release } = benchmark;
---

<section class="container gates" id="gates" aria-labelledby="gates-title">
  <h2 id="gates-title" class="visually-hidden">Upgrades passing each gate</h2>
  <GateFunnel
    client:visible
    lanes={funnelLanes()}
    steps={flowSteps}
    gates={gateDetails}
    datasetVersion={release.datasetVersion}
  />
</section>

<style>
  .gates {
    scroll-margin-top: var(--space-4);
  }
</style>
