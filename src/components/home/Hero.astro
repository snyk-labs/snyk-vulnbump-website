---
import { benchmark, getMetric, highlighted } from "../../data";
import { formatPercent } from "../../lib/format";
import { countWord } from "../../lib/words";

/*
 * 2b hero: headline and lede on the left; the highlighted agent's PASS rate
 * as the hero stat on the right, read from the data rather than hard-coded.
 */
const { tagline, headline, flowSteps } = benchmark;
const metric = getMetric(headline.metric);
const value = highlighted.values[metric.key] ?? 0;
const gates = countWord(flowSteps.length - 1).toLowerCase();
// Set links.paper in benchmark.json once the whitepaper is published.
const paperUrl = benchmark.links.paper;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow accent-pass">Snyk · SCA remediation benchmark</p>
    <h1 id="hero-title">
      {tagline.lead}<br /><span class="accent-pass">{tagline.keyword}</span>
    </h1>
    <p class="lede">
      {benchmark.researchQuestion} {highlighted.attempts} real upgrades, {gates} gates, one verdict.
    </p>
    <div class="button-row">
      <a class="button" href="/results">See the results →</a>
      <a class="button secondary" href="/methodology">How it works</a>
      {
        paperUrl ? (
          <a class="button secondary" href={paperUrl} rel="noreferrer">
            Read the whitepaper <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="button secondary pending">Whitepaper coming soon</span>
        )
      }
    </div>
  </div>

  <div class="hero-stat">
    <p class="hero-stat__value">{formatPercent(value)}</p>
    <p class="hero-stat__label">{headline.label}</p>
    <p class="hero-stat__meta">{headline.caption}</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-6) 4rem;
    padding-block: 5rem 3rem;
    align-items: end;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(3.2rem, 1.6rem + 6vw, 6.25rem);
    line-height: 0.95;
  }

  .lede {
    max-width: 37.5rem;
    margin-top: 1.75rem;
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .button-row {
    margin-top: 2rem;
  }

  /* Not yet a link: an outline in the site's dashed "not there yet" style. */
  .button.secondary.pending {
    border-style: dashed;
    color: var(--ink-faint);
    cursor: default;
  }

  .button.secondary.pending:hover {
    border-color: var(--rule-strong);
    background: transparent;
  }

  .hero-stat__value {
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.5fr 1fr;
    }
  }
</style>
