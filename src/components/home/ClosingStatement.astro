---
import { benchmark } from "../../data";
import GradientText from "../brand/GradientText.astro";
import BrandFabric from "../site/BrandFabric.astro";

const { citation, links } = benchmark;

const bibtex = citation
  ? [
      `@misc{${citation.bibtexKey},`,
      `  author = {${citation.authors.join(" and ")}},`,
      `  title = {${citation.title}},`,
      `  howpublished = {Snyk},`,
      `  year = {${citation.year}}${citation.url ? "," : ""}`,
      ...(citation.url ? [`  url = {${citation.url}}`] : []),
      "}",
    ].join("\n")
  : null;

const resources = [
  { label: "Read the paper", href: links.paper },
  { label: "Download the data", href: "/data" },
  { label: "Snyk publication", href: links.publication },
  { label: "GitHub", href: links.github },
  { label: "Benchmark harness", href: links.harness },
].filter((r): r is { label: string; href: string } => Boolean(r.href));
---

<section class="closing" aria-labelledby="closing-title">
  <BrandFabric corner="top-left" opacity={0.45} />

  <div class="container inner">
    <p class="eyebrow">Publication</p>
    <h2 id="closing-title">
      <span>Read it. Rerun it.</span>
      <GradientText text="Cite it." id="closing" align="middle" />
    </h2>
    <p class="lede">
      {
        links.paper
          ? "The methodology, versioned data, and paper live at stable public links."
          : "The methodology and versioned data are published here. The paper will be linked once it is public."
      }
    </p>

    <nav class="button-row" aria-label="Publication links">
      {
        resources.map(({ label, href }, i) => (
          <a class={i === 0 ? "button" : "button secondary"} href={href}>
            {label}
          </a>
        ))
      }
    </nav>

    {
      bibtex ? (
        <div class="citation gradient-border" data-bibtex-citation>
          <p class="eyebrow">Preferred citation</p>
          <pre><code>{bibtex}</code></pre>
          <div class="citation-actions">
            <button class="button secondary" type="button" data-copy-bibtex>
              Copy BibTeX
            </button>
            <span data-citation-status aria-live="polite" />
          </div>
        </div>
      ) : (
        <p class="pending metric">Citation published alongside the paper.</p>
      )
    }
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(8rem, 14vw, 12rem) var(--space-8);
    border-top: 1px solid var(--rule);
    text-align: center;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.6rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  h2 > span {
    display: block;
  }

  .lede {
    max-width: 34rem;
  }

  .button-row {
    justify-content: center;
    margin-top: var(--space-3);
  }

  .citation {
    width: min(100%, 44rem);
    padding: var(--space-4) var(--space-5);
    margin-top: var(--space-5);
    background: var(--midnight);
    text-align: left;
  }

  pre {
    margin: var(--space-3) 0;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .citation-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  [data-citation-status],
  .pending {
    color: var(--ink-faint);
    font-size: 0.74rem;
  }

  .pending {
    margin-top: var(--space-3);
  }
</style>

<script>
  let resetTimer: number | undefined;

  document.querySelectorAll<HTMLButtonElement>("[data-copy-bibtex]").forEach((button) => {
    button.addEventListener("click", async () => {
      const source = button.closest<HTMLElement>("[data-bibtex-citation]");
      const text = source?.querySelector("code")?.textContent;
      const status = source?.querySelector<HTMLElement>("[data-citation-status]");
      const fail = () => {
        if (status) status.textContent = "Select and copy the BibTeX entry manually.";
      };

      window.clearTimeout(resetTimer);
      if (!text || !navigator.clipboard?.writeText) return fail();

      try {
        await navigator.clipboard.writeText(text);
        if (status) {
          status.textContent = "Copied";
          resetTimer = window.setTimeout(() => {
            if (status.textContent === "Copied") status.textContent = "";
          }, 3_000);
        }
      } catch {
        fail();
      }
    });
  });
</script>
