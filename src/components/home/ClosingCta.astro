---
/* Closing panel: a single link to the results. */
---

<section class="container cta-section">
  <div class="cta">
    <a class="button" href="/results">See all results →</a>
  </div>
</section>

<style>
  .cta-section {
    padding-top: 4.5rem;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta .button {
    white-space: nowrap;
  }
</style>
