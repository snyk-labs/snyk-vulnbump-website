---
import { benchmark, configById, highlighted } from "../../data";

/* Closing panel: the paired result, derived from the data. */
const comparison = benchmark.paired.comparisons.find((c) => c.a === highlighted.id)!;
const other = configById(comparison.b);
---

<section class="container cta-section">
  <div class="cta panel-card">
    <p class="cta__text">
      The {highlighted.label} passes {comparison.aOnly} upgrades {other.label} fails, and fails
      {" "}{comparison.bOnly} it passes.
    </p>
    <a class="button" href="/results">All findings →</a>
  </div>
</section>

<style>
  .cta-section {
    padding-top: 4.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem;
  }

  .cta__text {
    max-width: 40rem;
    color: var(--ink);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .cta .button {
    white-space: nowrap;
  }
</style>
