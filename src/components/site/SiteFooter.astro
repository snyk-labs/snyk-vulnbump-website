---
import { benchmark } from "../../data";

const { release, model } = benchmark;
// Pages outside the primary nav stay reachable here.
const footerLinks = [
  { label: "Data", href: "/data" },
  { label: "About", href: "/about" },
  { label: "Privacy", href: "https://snyk.io/policies/privacy/" },
  { label: "Terms", href: "https://snyk.io/policies/terms-of-service/" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="line">
      <p>All agents run {model.name} · Run {release.runDate} · Snyk</p>
      <p class="metric">Dataset {release.datasetVersion}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {footerLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink-faint);
    font-size: 0.8125rem;
  }

  .footer-inner {
    display: grid;
    padding-block: 3rem;
    gap: var(--space-3);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
    gap: 0.4rem 1.25rem;
    list-style: none;
  }

  a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
  }
</style>
