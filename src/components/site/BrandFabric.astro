---
/*
 * Corner fabric halftone. One corner per section, always on a single diagonal
 * (top-left ↔ bottom-right across the site), never behind copy or the logo.
 * Reduced-opacity PNG: no mask-image.
 */
interface Props {
  corner: "top-left" | "bottom-right";
  opacity?: number;
}

const { corner, opacity = 0.55 } = Astro.props;
const src =
  corner === "top-left"
    ? "/brand/snyk-2026/ULC_Fabric_Gradient.png"
    : "/brand/snyk-2026/BRC_Fabric_Gradient.png";
---

<div
  class:list={["brand-fabric", `brand-fabric--${corner}`]}
  style={`background-image: url("${src}"); opacity: ${opacity};`}
  aria-hidden="true"
>
</div>

<style>
  .brand-fabric {
    position: absolute;
    z-index: 0;
    width: min(46rem, 70vw);
    aspect-ratio: 5667 / 3316;
    background-repeat: no-repeat;
    background-size: contain;
    pointer-events: none;
  }

  .brand-fabric--bottom-right {
    right: 0;
    bottom: 0;
    background-position: right bottom;
  }

  .brand-fabric--top-left {
    top: 0;
    left: 0;
    background-position: left top;
  }
</style>
