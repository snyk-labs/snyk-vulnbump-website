---
interface Props {
  eyebrow: string;
  title: string;
  /** Optional second line of the title, set in the PASS accent. */
  keyword?: string;
  description: string;
}

const { eyebrow, title, keyword, description } = Astro.props;
---

<header class="page-hero">
  <div class="container page-hero__inner">
    <div class="copy">
      <p class="eyebrow accent-pass">{eyebrow}</p>
      <h1>
        {title}
        {keyword && <span class="keyword accent-pass">{keyword}</span>}
      </h1>
      <p class="lede">{description}</p>
      <div class="actions">
        <slot name="actions" />
      </div>
    </div>
    <aside>
      <slot name="aside" />
    </aside>
  </div>
</header>

<style>
  .page-hero {
    padding-block: 4.5rem 0;
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-6) 4.5rem;
  }

  .copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.5rem);
    line-height: 1;
  }

  .keyword {
    display: block;
  }

  .lede {
    max-width: 42.5rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    margin-top: var(--space-2);
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .actions:empty,
  aside:empty {
    display: none;
  }

  @media (min-width: 60rem) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
    }
  }
</style>
