---
import { benchmark, site } from "../../data";

const { release } = benchmark;
const tag = release.status === "draft" ? `${release.shortName} draft` : release.shortName;
---

<a class="wordmark" href="/" aria-label={`${site.shortName} home`}>
  <!-- Ascending purple steps, the last cut short in orange: three gates pass, one fails. -->
  <img class="mark" src="/brand/logo-mark.svg" alt="" width="24" height="24" />
  <span class="name">{site.shortName}</span>
  <span class="version metric">{tag}</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
  }

  .name {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .version {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.25rem;
    color: var(--ink-faint);
    font-size: 0.75rem;
  }
</style>
