---
/*
 * Numeral-as-hero: a giant Geist figure drawn as a Brand-Gradient neon
 * outline with a real outer glow (the brand's "circle-glow" treatment).
 * Decorative only; the exact value is given in adjacent text.
 */
interface Props {
  value: string;
  id: string;
  align?: "start" | "middle";
}

const { value, id, align = "start" } = Astro.props;
const x = align === "middle" ? "50%" : "0.04em";
// Geist Bold digits run ~0.57em each at this tracking; size the figure so the
// whole value fits the container's width.
const widthEm = (value.length * 0.6).toFixed(2);
---

<div class="hero-numeral-box" style={`--numeral-em: ${widthEm}`}>
<svg class="hero-numeral" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`num-${id}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#6F00DD"></stop>
      <stop offset="35%" stop-color="#FF00FF"></stop>
      <stop offset="68%" stop-color="#F3552E"></stop>
      <stop offset="100%" stop-color="#FE9104"></stop>
    </linearGradient>
    <filter id={`glow-${id}`} x="-15%" y="-25%" width="130%" height="150%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="10" result="wide"></feGaussianBlur>
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="near"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="wide"></feMergeNode>
        <feMergeNode in="near"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  <text
    x={x}
    y="0.86em"
    text-anchor={align}
    fill="none"
    stroke={`url(#num-${id})`}
    filter={`url(#glow-${id})`}
  >
    {value}
  </text>
</svg>
</div>

<style>
  .hero-numeral-box {
    container-type: inline-size;
  }

  .hero-numeral {
    display: block;
    width: 100%;
    height: 1.02em;
    overflow: visible;
    font-size: min(11.5rem, calc(100cqi / var(--numeral-em)));
  }

  text {
    font-family: var(--font-sans);
    font-size: 1em;
    font-weight: 700;
    letter-spacing: -0.05em;
    stroke-width: clamp(2px, 0.28vw, 3.5px);
  }
</style>
