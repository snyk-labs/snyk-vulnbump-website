---
/*
 * Brand-Gradient keyword as inline SVG text (the brand's webview/PDF-safe
 * pattern; never background-clip: text). Inherits font size and weight from
 * its parent, so it sits inside a heading as its own line or as an inline
 * numeral. The pink-forward text gradient never uses Plum.
 */
interface Props {
  text: string;
  /** Unique per page: used for the gradient id. */
  id: string;
  /** `block` takes the full line; `inline` sizes to roughly the text width. */
  layout?: "block" | "inline";
  /** Horizontal alignment of a block keyword. */
  align?: "start" | "middle";
}

const { text, id, layout = "block", align = "start" } = Astro.props;
const gradientId = `grad-${id}`;
// Inline width estimate in em for Geist Bold; trailing slack is invisible.
const inlineWidth = `${Math.max(1, text.length * 0.64)}em`;
---

<span class:list={["gradient-text", `gradient-text--${layout}`]}>
  <span class="visually-hidden">{text}</span>
  <svg
    aria-hidden="true"
    focusable="false"
    style={layout === "inline" ? `width: ${inlineWidth}` : undefined}
  >
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#6F00DD"></stop>
        <stop offset="35%" stop-color="#FF00FF"></stop>
        <stop offset="68%" stop-color="#F3552E"></stop>
        <stop offset="100%" stop-color="#FE9104"></stop>
      </linearGradient>
    </defs>
    <text
      x={align === "middle" ? "50%" : "0"}
      y="0.8em"
      text-anchor={align}
      fill={`url(#${gradientId})`}>{text}</text
    >
  </svg>
</span>

<style>
  .gradient-text {
    display: block;
  }

  .gradient-text--inline {
    display: inline-block;
    vertical-align: -0.12em;
  }

  svg {
    display: block;
    width: 100%;
    height: 1.02em;
    overflow: visible;
  }

  text {
    font-family: inherit;
    font-size: 1em;
    font-weight: inherit;
    letter-spacing: inherit;
  }
</style>
